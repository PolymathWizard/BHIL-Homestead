{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PolymathWizard/BHIL-Homestead/schemas/scorecard.schema.json",
  "title": "HOMESTEAD authenticity scorecard",
  "type": "object",
  "required": ["engagement", "preset", "auditor", "rows"],
  "properties": {
    "engagement": {"type": "string"},
    "preset": {"type": "string", "enum": ["A", "B", "C", "D", "E", "F"]},
    "auditor": {"type": "string"},
    "date": {"type": "string"},
    "rows": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["row", "score", "evidence"],
        "properties": {
          "row": {"type": "integer", "minimum": 1, "maximum": 20},
          "check": {"type": "string"},
          "score": {"type": ["integer", "null"], "minimum": 0, "maximum": 2},
          "evidence": {"type": "string"}
        }
      }
    },
    "total": {"type": ["integer", "null"]},
    "verdict": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  }
}
