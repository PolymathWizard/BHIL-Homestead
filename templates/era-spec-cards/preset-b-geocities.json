{
  "preset": "B",
  "preset_name": "GeoCities / Angelfire / Tripod personal homepage",
  "year": 1997,
  "host_context": "Free homestead in a themed neighborhood, for example SiliconValley/Heights/4021",
  "target_browser": "Netscape Navigator 3 or 4",
  "canvas_width_px": 600,
  "palette_mode": "web-safe-216",
  "base_bg": "#000000 with images/stars-tile.gif",
  "palette": {
    "bg": "#000000",
    "text": "#FFFFFF",
    "link": "#00FFFF",
    "vlink": "#FF00FF",
    "alink": "#FFFF00"
  },
  "fonts": {
    "body": "Times New Roman, Times, serif",
    "heading": "Arial, Helvetica, sans-serif",
    "display": "Comic Sans MS, cursive",
    "mono": "Courier New, Courier, monospace"
  },
  "layout_mode": "centered-column",
  "nav_style": "Text links separated by pipes at top and bottom, plus a few button GIFs.",
  "required_widgets": [
    "safe-mode-toggle",
    "text-only-link",
    "last-updated",
    "email-me",
    "browser-badge",
    "hit-counter",
    "guestbook",
    "webring",
    "under-construction",
    "rainbow-rule",
    "neighborhood-address",
    "whats-new",
    "midi-player"
  ],
  "required_any": [],
  "forbidden_elements": [
    "glitter text",
    "Top 8 grids",
    "shared borders",
    "theme banners",
    "web fonts",
    "rounded corners",
    "CSS gradients",
    "emoji"
  ],
  "voice_rules": [
    "Exuberant, personal, generous with exclamation points and capital letters.",
    "Example: Welcome to my HOMEPAGE!!!",
    "Example: Sign my guestbook!",
    "Example: This page is under construction, come back soon!",
    "Example: You are visitor number",
    "Example: Thanks for stopping by!"
  ],
  "motion_budget": 4,
  "audio": "click-to-play",
  "easter_eggs": [
    "Neighborhood address that matches the topic",
    "Last updated date that is slightly stale",
    "Webring previous and next links",
    "A generic Best viewed at 800x600 badge"
  ],
  "time_capsule": false,
  "time_capsule_story": "",
  "allowed_extra_widgets": [],
  "reference_urls": [],
  "asset_policy": "originals-only"
}
