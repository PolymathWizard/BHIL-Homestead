{
  "preset": "E",
  "preset_name": "MySpace profile / Xanga / LiveJournal",
  "year": 2006,
  "host_context": "A profile on a social network with user CSS pasted into About Me",
  "target_browser": "Firefox 2 or Internet Explorer 6 or 7",
  "canvas_width_px": 800,
  "palette_mode": "full",
  "base_bg": "#000000",
  "palette": {
    "bg": "#000000",
    "text": "#FFFFFF",
    "link": "#FF66CC",
    "vlink": "#CC99FF",
    "alink": "#00FFFF"
  },
  "fonts": {
    "body": "Verdana, Arial, sans-serif",
    "heading": "Verdana, Arial, sans-serif",
    "display": "Comic Sans MS, cursive",
    "mono": "Courier New, Courier, monospace"
  },
  "layout_mode": "profile-template",
  "nav_style": "A thin network nav bar across the top, then profile sections. Links live in About Me.",
  "required_widgets": [
    "safe-mode-toggle",
    "text-only-link",
    "user-css-layout",
    "profile-blurbs",
    "interests-details",
    "contact-table",
    "top-8",
    "comments-wall",
    "profile-music-player",
    "glitter-text",
    "blinkies",
    "online-now",
    "profile-views"
  ],
  "required_any": [],
  "forbidden_elements": [
    "shared borders",
    "theme banners",
    "webrings",
    "hit counters",
    "neighborhood addresses",
    "web fonts",
    "emoji",
    "real song lyrics",
    "network logos or wordmarks"
  ],
  "voice_rules": [
    "Teen-confessional, decorated punctuation, inside jokes. Never quote real song lyrics.",
    "Example: ~*~xOxO~*~",
    "Example: thanks for the add!!",
    "Example: PC4PC",
    "Example: i heart spreadsheets",
    "Example: rawr means i love you in dinosaur"
  ],
  "motion_budget": 6,
  "audio": "click-to-play",
  "easter_eggs": [
    "Thanks for the add graphics in comments",
    "Online Now indicator",
    "Top 8 ordering that tells a story",
    "A comment that says PC4PC"
  ],
  "time_capsule": false,
  "time_capsule_story": "",
  "allowed_extra_widgets": [],
  "reference_urls": [],
  "asset_policy": "originals-only"
}
